# ============================================================================
# PGS Oman — Executive Virtual Assistant Backend Configuration (.env.example)
# ============================================================================
# Instructions for Setup:
# 1. Copy this file and rename the copy to `.env` in the project root folder:
#      cp .env.example .env
# 2. Paste your actual Google Gemini or OpenAI API key in `.env`.
# 3. Run `npm run dev` to start both the backend (port 3005) and frontend (port 5173).
# ============================================================================

# 1. Backend Server Port
PORT=3005

# 2. Live LLM Provider ('gemini' or 'openai')
AI_PROVIDER=gemini

# 3. Google Gemini API Configuration (Recommended)
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 4. OpenAI API Configuration (Optional Alternative)
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
